# このマシン固有の1Password参照設定（実ファイルはgitignore対象）
#
# 使い方:
#   cp chezmoi.local.yml.example chezmoi.local.yml
#   その後、実際の値に書き換える。
#
# 1Passwordは複数アカウント同時サインインをしない運用のため、account指定は不要
# （op readはそのマシンでサインインしている唯一のアカウントを自動的に使う）。

chezmoi_git_identity:
  onepassword_username_path: "op://<vault>/<item>/username"
  onepassword_email_path: "op://<vault>/<item>/email"
  onepassword_signing_key_path: "op://<vault>/id_ed25519/public_key"
